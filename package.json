{
  "name": "cult",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "setup": "npm install && npm run generate:synthetic",
    "dev": "concurrently -n API,WEB -c yellow,cyan \"npm run dev -w @cult/api\" \"npm run dev -w @cult/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "generate:synthetic": "tsx scripts/generate-synthetic.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "eslint": "9.34.0",
    "globals": "^16.3.0",
    "pg": "^8.16.3",
    "@types/pg": "^8.15.5",
    "prettier": "3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "^3.2.4"
  },
  "engines": { "node": ">=20" }
}
